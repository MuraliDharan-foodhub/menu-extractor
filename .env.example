# OCR Engine selection: "google" (default) or "tesseract"
OCR_ENGINE=google

# Google Cloud Vision — OAuth2 credentials (preferred)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Cloud Vision — API key (alternative, used when OAuth2 vars are absent)
GOOGLE_API_KEY=

# FoodHub CDN API token — used to publish menus to the external FoodHub API
FHCDN_API_TOKEN=
