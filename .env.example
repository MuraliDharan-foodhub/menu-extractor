# OCR Engine selection: "google" (default), "tesseract", or "gemini"
# - google: Google Cloud Vision API (text extraction + rule-based parsing, flat category structure)
# - tesseract: Tesseract.js local OCR (text extraction + rule-based parsing, flat category structure)  
# - gemini: Google Gemini API (AI-powered structured extraction with category/subcategory hierarchy, better accuracy)
OCR_ENGINE=google

# Google Cloud Vision — OAuth2 credentials (preferred)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Cloud Vision — API key (alternative, used when OAuth2 vars are absent)
GOOGLE_API_KEY=

# Google Gemini API key — required when OCR_ENGINE=gemini
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# FoodHub CDN API token — used to publish menus to the external FoodHub API
FHCDN_API_TOKEN=
